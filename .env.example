# Copy to backend/.env — never commit the real file.

# PostgreSQL (Neon / Vercel Postgres / local)
POSTGRES_URL=postgresql://user:password@localhost:5432/cjdb?sslmode=prefer
# DATABASE_URL is accepted as an alias of POSTGRES_URL

# Auth — required in production (no hardcoded fallback)
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=30d

# Razorpay (optional until Super Admin keys are migrated)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Public origins for CORS (comma-separated). Include frontend + admin Vercel URLs.
CORS_ORIGINS=http://localhost:8080,https://chandrakala-jewellers.vercel.app,https://YOUR-ADMIN-PROJECT.vercel.app

# Optional: create the first admin only when admin_users is empty.
# Do not put production staff passwords here. Import PHP hashes instead.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_ROLE=superadmin


# Public media (PHP host until files are migrated)
PUBLIC_UPLOADS_BASE=https://chandrakalajewellers.in/uploads/
PUBLIC_CATALOGUE_BASE=https://chandrakalajewellers.in/catalogue/
